    select HAVE_ACPI_RESUME
    select HAVE_ACPI_TABLES
    select HAVE_SPD_IN_CBFS
    select INTEL_GMA_HAVE_VBT
    select MAINBOARD_HAS_LIBGFXINIT
    select SOC_INTEL_COMMON_BLOCK_HDA_VERB
    select SOC_INTEL_KABYLAKE
    select SYSTEM_TYPE_LAPTOP

config MAINBOARD_DIR
	default "xiaomi/tm1703"

config MAINBOARD_PART_NUMBER
	default "Mi Notebook Air 13.3\" (TM1703)"

config VGA_BIOS_ID
	default "8086,5917"

config INTEL_GMA_VBT_FILE
	default "src/mainboard/\$(MAINBOARDDIR)/data.vbt"

config FMDFILE
	default "src/mainboard/xiaomi/tm1703/board.fmd"

config CONSOLE_SPI_FLASH_BUFFER_SIZE
	default 0x180000

config TM1703_DEBUG_FSP
	bool "Log FSP calls and status"
	default n
	select DISPLAY_FSP_CALLS_AND_STATUS
	help
	  Log FspSiliconInit calls and return status to flashconsole during
	  early board bring-up.

config DIMM_MAX
	default 1

config DIMM_SPD_SIZE
    default 512

config CBFS_SIZE
	default 0x46f800

config MRC_SETTINGS_CACHE_SIZE
	default 0x10000

config MRC_SETTINGS_PROTECT
	default y

# Use coreinfo when an ELF payload is selected for early bring-up.
config PAYLOAD_FILE
	default "payloads/coreinfo/build/coreinfo.elf"

# This platform has limited means to display POST codes
config NO_POST
    default y


/* Mainboard ACPI devices for Xiaomi Mi Notebook Air 13.3" (TM1703) */

External (\_SB.PCI0.LPCB.EC0.MLID, FieldUnitObj)

Scope (\_SB)
{
	/* Lid Switch */
	Device (LID0)
	{
		Name (_HID, EisaId ("PNP0C0D"))
		Method (_STA, 0, NotSerialized)
		{
			Return (0x0f)
		}

		Method (_LID, 0, NotSerialized)
		{
			Return (\_SB.PCI0.LPCB.EC0.MLID)
		}
	}

	/* Sleep Button */
	Device (SLPB)
	{
		Name (_HID, EisaId ("PNP0C0E"))
		Name (_STA, 0x0b)
	}

	/* Xiaomi WMI hotkey interface */
	Name (BTID, Zero)

	Device (WMID)
	{
		Name (_HID, "PNP0C14")
		Name (_UID, "WOSD")
		Name (_WDG, Buffer (0x28)
		{
			/* 0000 */  0x21, 0x12, 0x90, 0x05, 0x66, 0xD5, 0xD1, 0x11,
			/* 0008 */  0xB2, 0xF0, 0x00, 0xA0, 0xC9, 0x06, 0x29, 0x10,
			/* 0010 */  0x4D, 0x4F, 0x01, 0x00, 0x74, 0x0F, 0xBC, 0xAB,
			/* 0018 */  0xA1, 0x8E, 0xD1, 0x11, 0x00, 0xA0, 0xC9, 0x06,
			/* 0020 */  0x29, 0x10, 0x00, 0x00, 0xD2, 0x00, 0x01, 0x08
		})

		Method (_WED, 1, NotSerialized)
		{
			If (Arg0 == 0xD2)
			{
				Local0 = BTID
				BTID = Zero
				Return (Local0)
			}
			Return (Zero)
		}


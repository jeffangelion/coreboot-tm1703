# SPDX-License-Identifier: GPL-2.0-only

chip soc/intel/skylake

	register "eist_enable" = "true"
	register "DspEnable" = "false"
	register "SkipExtGfxScan" = "1"
	register "SaGv" = "SaGv_Enabled"
	register "PmConfigSlpS3MinAssert" = "2"
	register "PmConfigSlpS4MinAssert" = "1"
	register "PmConfigSlpSusMinAssert" = "3"
	register "PmConfigSlpAMinAssert" = "3"

	# GPE configuration
	register "gpe0_dw0" = "GPP_C"
	register "gpe0_dw1" = "GPP_D"
	register "gpe0_dw2" = "GPP_E"

	register "SerialIoDevMode" = "{
		[PchSerialIoIndexI2C0] = PchSerialIoPci,
		[PchSerialIoIndexI2C1] = PchSerialIoPci,
	}"

	device domain 0 on
		device ref igpu on
			register "gfx" = "GMA_STATIC_DISPLAYS(0)"
			register "panel_cfg" = "{
				.up_delay_ms = 200,
				.down_delay_ms = 50,
				.cycle_delay_ms = 500,
				.backlight_on_delay_ms = 1,
				.backlight_off_delay_ms = 200,
				.backlight_pwm_hz = 200,
			}"
		end
		device ref sa_thermal on end
		device ref thermal on end
		device ref south_xhci on
			register "usb2_ports" = "{
				[0] = USB2_PORT_MID(OC_SKIP),		/* Type-A port right */
				[2] = USB2_PORT_TYPE_C(OC_SKIP),	/* Type-C port */
				[3] = USB2_PORT_MID(OC_SKIP),		/* Type-A port left */
				[4] = USB2_PORT_FLEX(OC_SKIP),		/* XiaoMi USB 2.0 Webcam */
				[5] = USB2_PORT_FLEX(OC_SKIP),		/* ELAN Fingerprint */
				[6] = USB2_PORT_FLEX(OC_SKIP),		/* Intel Bluetooth 8265 */
			}"
			register "usb3_ports" = "{
				[0] = USB3_PORT_DEFAULT(OC_SKIP),	/* Type-A port right */
				[2] = USB3_PORT_DEFAULT(OC_SKIP),	/* Type-C port */
				[3] = USB3_PORT_DEFAULT(OC_SKIP),	/* Type-A port left */
			}"
		end
		device ref heci1 on end
		device ref sata on
			register "SataSalpSupport" = "1"
			register "SataPortsEnable[0]" = "1"
			register "SataPortsDevSlp[0]" = "1"
		end
		device ref hda on end
		device ref smbus on end
		device ref i2c0 on end
		device ref i2c1 on
			chip drivers/i2c/hid
				register "generic.hid" = ""ELAN2301""
				register "generic.desc" = ""ELAN Touchpad""
				register "generic.irq" = "ACPI_IRQ_WAKE_LEVEL_LOW(GPP_B3_IRQ)"
				register "generic.name" = ""TPD0""
				register "generic.detect" = "1"
				register "hid_desc_reg_offset" = "0x01"
				device i2c 0x15 on end
			end
		end
		device ref fast_spi on end
		device ref pcie_rp1 on
			# NVIDIA GP108M discrete GPU, PCIe x4.
			register "PcieRpClkReqSupport[0]" = "false"
			register "PcieRpClkSrcNumber[0]" = "2"
			chip drivers/pcie/rtd3/device
				register "name" = ""PXSX""
				register "enable_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_G4)"
				register "enable_delay_ms" = "16"
				register "enable_off_delay_ms" = "4"
				register "reset_gpio" = "ACPI_GPIO_OUTPUT_ACTIVE_LOW(GPP_G1)"
				register "reset_delay_ms" = "10"
				register "reset_off_delay_ms" = "4"
				device pci 00.0 on end
			end
		end
		device ref pcie_rp5 on
			# Intel Wireless 8265, PCIe x1.
			register "PcieRpClkReqSupport[4]" = "false"
			register "PcieRpClkReqNumber[4]" = "0"
			register "PcieRpClkSrcNumber[4]" = "3"
		end
		device ref pcie_rp9 on
			# M.2 NVMe SSD, PCIe x4.
			register "PcieRpClkReqSupport[8]" = "false"
			register "PcieRpClkReqNumber[8]" = "1"
			register "PcieRpClkSrcNumber[8]" = "5"
		end
		device ref lpc_espi on end
	end
end
